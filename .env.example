# Global Vegan Marketplace Environment Variables

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="VeganVerse India"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@veganverse.in"

# Supabase Credentials (Get these from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (NEVER expose to client; used strictly in Server Actions for Admin tasks)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Email Integration (Resend API)
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="VeganVerse Notifications <notifications@veganverse.in>"
ADMIN_NOTIFICATION_EMAIL="admin@veganverse.in"

